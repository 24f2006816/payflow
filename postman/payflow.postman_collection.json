{
  "info": {
    "_postman_id": "55b3942d-54bc-4341-9290-751ce0caeb86",
    "name": "PayFlow API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run folders in order. Tokens and ids are captured into collection variables by test scripts."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "merchantId",
      "value": "11111111-1111-1111-1111-111111111111"
    },
    {
      "key": "walletId",
      "value": "33333333-3333-3333-3333-333333333333"
    },
    {
      "key": "paymentId",
      "value": ""
    },
    {
      "key": "serviceToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "merchantToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Auth",
      "item": [
        {
          "name": "Token: checkout-service",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "auth",
                "token"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_id\": \"checkout-service\",\n  \"client_secret\": \"service-secret-change-me\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('serviceToken', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Token: admin-cli",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "auth",
                "token"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_id\": \"admin-cli\",\n  \"client_secret\": \"admin-secret-change-me\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('adminToken', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Token: acme-merchant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "auth",
                "token"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_id\": \"acme-merchant\",\n  \"client_secret\": \"merchant-secret-change-me\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('merchantToken', pm.response.json().access_token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Accounts",
      "item": [
        {
          "name": "Open customer wallet",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{serviceToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/accounts/wallets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "accounts",
                "wallets"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{$guid}}\",\n  \"currency\": \"INR\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('walletId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get wallet",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{serviceToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/accounts/{{walletId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "accounts",
                "{{walletId}}"
              ]
            }
          }
        },
        {
          "name": "Wallet statement",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{serviceToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/accounts/{{walletId}}/postings?limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "accounts",
                "{{walletId}}",
                "postings"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Top-ups",
      "item": [
        {
          "name": "Top up 50,000",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{serviceToken}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/topups",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "topups"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountId\": \"{{walletId}}\",\n  \"amountMinor\": 50000,\n  \"currency\": \"INR\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('created', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Declined top-up (amount ends in 13)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{serviceToken}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/topups",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "topups"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountId\": \"{{walletId}}\",\n  \"amountMinor\": 10013,\n  \"currency\": \"INR\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "3. Payments",
      "item": [
        {
          "name": "Authorize 12,000",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{serviceToken}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "payments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"merchantId\": \"{{merchantId}}\",\n  \"customerAccountId\": \"{{walletId}}\",\n  \"amountMinor\": 12000,\n  \"currency\": \"INR\",\n  \"description\": \"order #1001\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('paymentId', pm.response.json().id);",
                  "pm.test('authorized', () => pm.expect(pm.response.json().status).to.eql('AUTHORIZED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Capture 10,000",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{serviceToken}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/payments/{{paymentId}}/capture",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "payments",
                "{{paymentId}}",
                "capture"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amountMinor\": 10000\n}"
            }
          }
        },
        {
          "name": "Refund 2,500",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{serviceToken}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/payments/{{paymentId}}/refunds",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "payments",
                "{{paymentId}}",
                "refunds"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amountMinor\": 2500,\n  \"reason\": \"damaged\"\n}"
            }
          }
        },
        {
          "name": "Get payment",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{serviceToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/payments/{{paymentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "payments",
                "{{paymentId}}"
              ]
            }
          }
        },
        {
          "name": "List merchant payments (as merchant)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{merchantToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/payments?merchantId={{merchantId}}&page=0&size=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "payments"
              ],
              "query": [
                {
                  "key": "merchantId",
                  "value": "{{merchantId}}"
                },
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "Cancel (fails after capture: 409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{serviceToken}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/payments/{{paymentId}}/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "payments",
                "{{paymentId}}",
                "cancel"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. Merchants (admin)",
      "item": [
        {
          "name": "Create merchant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/merchants",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "merchants"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Shop\",\n  \"webhookUrl\": \"http://webhook-sink:8080/hooks/new\",\n  \"currencies\": [\n    \"INR\",\n    \"USD\"\n  ]\n}"
            }
          }
        },
        {
          "name": "Get Acme",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/merchants/{{merchantId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "merchants",
                "{{merchantId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "5. Admin",
      "item": [
        {
          "name": "Run reconciliation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/admin/reconciliation/runs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "admin",
                "reconciliation",
                "runs"
              ]
            }
          }
        },
        {
          "name": "Latest reconciliation",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/admin/reconciliation/runs/latest",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "admin",
                "reconciliation",
                "runs",
                "latest"
              ]
            }
          }
        }
      ]
    }
  ]
}