{
  "family": "payflow",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "runtimePlatform": { "cpuArchitecture": "X86_64", "operatingSystemFamily": "LINUX" },
  "executionRoleArn": "arn:aws:iam::REPLACE_ACCOUNT:role/payflowTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::REPLACE_ACCOUNT:role/payflowTaskRole",
  "containerDefinitions": [
    {
      "name": "payflow",
      "image": "REPLACE_ACCOUNT.dkr.ecr.REPLACE_REGION.amazonaws.com/payflow:REPLACE_TAG",
      "essential": true,
      "portMappings": [{ "containerPort": 8080, "protocol": "tcp" }],
      "environment": [
        { "name": "SPRING_PROFILES_ACTIVE", "value": "prod" },
        { "name": "DB_URL", "value": "jdbc:postgresql://REPLACE_RDS_ENDPOINT:5432/payflow?sslmode=require" },
        { "name": "REDIS_HOST", "value": "REPLACE_ELASTICACHE_ENDPOINT" },
        { "name": "KAFKA_BOOTSTRAP_SERVERS", "value": "REPLACE_MSK_BOOTSTRAP:9092" },
        { "name": "JWT_ISSUER", "value": "https://payments.example.com" }
      ],
      "secrets": [
        { "name": "DB_USERNAME", "valueFrom": "arn:aws:secretsmanager:REPLACE_REGION:REPLACE_ACCOUNT:secret:payflow/db:username::" },
        { "name": "DB_PASSWORD", "valueFrom": "arn:aws:secretsmanager:REPLACE_REGION:REPLACE_ACCOUNT:secret:payflow/db:password::" },
        { "name": "JWT_SECRET", "valueFrom": "arn:aws:secretsmanager:REPLACE_REGION:REPLACE_ACCOUNT:secret:payflow/jwt:secret::" }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "wget -qO- http://localhost:8080/actuator/health/readiness || exit 1"],
        "interval": 15, "timeout": 3, "retries": 3, "startPeriod": 60
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/payflow",
          "awslogs-region": "REPLACE_REGION",
          "awslogs-stream-prefix": "app"
        }
      },
      "stopTimeout": 40
    }
  ]
}
