# Copy to .env (docker compose reads it automatically). Never commit real secrets.
DB_URL=jdbc:postgresql://localhost:5432/payflow
DB_USERNAME=payflow
DB_PASSWORD=payflow
DB_POOL_SIZE=20
REDIS_HOST=localhost
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# HS256 key, at least 32 bytes. Generate: openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me-0123
JWT_ISSUER=https://payflow.local
FEE_BPS=200
RATE_LIMIT_RPM=600
WEBHOOKS_ALLOW_HTTP=false
WEBHOOKS_ALLOW_PRIVATE=false
TRACING_SAMPLING=1.0
